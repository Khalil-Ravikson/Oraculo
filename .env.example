# .env.example — copie para `.env` e preencha os valores reais.
# Nunca commitar o `.env` de verdade (já está no .gitignore).
#
# Este arquivo não existia no repo antes desta rodada — só ler o código
# (src/infrastructure/settings.py) pra saber quais variáveis existem, sem
# nenhuma referência de valores seguros/default. Ver `.claude.md` seção
# "Pontos de Atenção Técnicos" pro histórico de incidentes já causados por
# essa lacuna (ex.: GEMINI_MODEL com nome de preview descontinuado).

# ── Ambiente ──────────────────────────────────────────────────
DEV_MODE=false
LOG_LEVEL=INFO
ENV=production

# ── Banco de Dados ────────────────────────────────────────────
# Sob docker-compose, o bloco `environment:` do serviço sobrescreve
# DATABASE_URL para `postgresql+asyncpg://user:${POSTGRES_PASSWORD}@172.18.0.40:5432/oraculo`
# e o serviço `postgres` usa POSTGRES_USER=user / POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
# / POSTGRES_DB=oraculo. Sem POSTGRES_PASSWORD o container postgres entra em
# crash-loop ("Database is uninitialized and superuser password is not specified").
# Mantenha o usuário/senha do DATABASE_URL abaixo iguais aos de POSTGRES_PASSWORD.
POSTGRES_PASSWORD=oraculo
DATABASE_URL=postgresql+asyncpg://user:oraculo@postgres:5432/oraculo
REDIS_URL=redis://redis:6379/0

# ── docker-compose profiles ───────────────────────────────────
# Sem isso, `docker compose up -d` sem `--profile` não sobe NADA (erro
# "no such service") — achado documentado em .claude.md. Ajuste a lista
# conforme o que você realmente quer rodar (core/monitoring/app/gateway).
COMPOSE_PROFILES=core,monitoring,app,gateway

# ── LLM — Gemini (provider default) ───────────────────────────
GEMINI_API_KEY=
# Fixar em versão estável testada — nomes "preview"/"experimental" já
# causaram 404 real em produção (notas.md §9.10: gemini-3.1-flash-lite-preview).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMP=0.2
GEMINI_MAX_TOKENS=1024
# Model tiering (ADR 0008): modelo barato pros passos de alto volume
# (classificação de rota, transform de query, resumo de memória, parsing).
# Vazio = usa o mesmo GEMINI_MODEL. A síntese da resposta ao aluno SEMPRE
# usa o GEMINI_MODEL forte. Só vale com LLM_PROVIDER=gemini.
LLM_MODEL_FAST=

# ── LLM — multi-provider (ver infrastructure/adapters/llm_factory.py) ──
# Provider ativo por padrão. Trocável em runtime sem restart via
# /hub/llm-custo (grava em Redis `admin:llm_provider`), ou por agente em
# /hub/agents (grava em Postgres `agentes_catalogo.llm_provider`).
LLM_PROVIDER=gemini
# "gemini" | "deepseek" | "groq"

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── RAG ───────────────────────────────────────────────────────
PDF_PARSER=pymupdf
LLAMA_CLOUD_API_KEY=
HF_TOKEN=
DATA_DIR=/app/dados
MAX_HISTORY_MESSAGES=20
# Docling carrega modelos ML pesados no pre-load do worker — causa real de
# SIGKILL sob pressão de memória (notas.md §8.5/8.6). true desativa.
DISABLE_DOCLING=false

# ── WhatsApp (Evolution API) ──────────────────────────────────
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Rota real é POST /webhook/evolution — não .../webhook (bug real já
# causou "webhook mudo" em produção, ver notas.md §9.1).
WHATSAPP_HOOK_URL=http://api:9000/webhook/evolution
ALLOWED_GROUP_ID=
# Pra onde o nó `human_handoff` avisa quando alguém pede atendente humano
# (ADR 0008). Vazio → cai no 1º número de ADMIN_NUMBERS.
SUPPORT_GROUP_JID=

# ── mcp_lab (laboratório de estudo MCP) ───────────────────────
BRAVE_API_KEY=
GITHUB_API_KEY=

# ── Admin ─────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_API_KEY=
ADMIN_NUMBERS=
ADMIN_CONFIRMATION_TOKEN=
STUDENT_NUMBERS=

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_PROVIDER=google

# ── Grafana (docker-compose) ──────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Tracing (OpenTelemetry → Jaeger, profile "monitoring") ─────
# Desativado por padrão — só liga com o container `jaeger` no ar
# (docker compose --profile monitoring up). UI em localhost:16686.
ENABLE_TRACING=false
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317

# ── Câmbio USD→BRL (fallback fixo; taxa ao vivo via task Celery
# `atualizar_taxa_brl`, editável em /hub/llm-custo) ─────────────
USD_BRL_RATE=5.40

# ── Flags de desenvolvimento (nunca true em produção) ─────────
DEV_TEST_NO_DB_WRITE=false
DEV_TEST_SKIP_REGISTRATION=false
ENABLE_NIGHTLY_MEMORY=false

# ── Plano de integração LangGraph/REST/MCP (docs/decisions/, Fase 1) ──
# Desligadas por padrão; ligar só depois de cada fase correspondente
# fechar seus critérios de sucesso.
FEATURE_LANGGRAPH_CELERY_DISPATCH=false
FEATURE_REST_PRODUCT=false
FEATURE_MCP_PRODUCT=false
# v1 — bot de menu. Ligada: o menu determinístico decide a rota e o
# classificador LLM não roda (navegar custa zero token). Desligar só como
# rollback — ver docs/ESTADO_ATUAL.md §1.
FEATURE_MENU_BOT=true
# Reescrita da query de busca por Gemini Flash antes do RAG. Desligada no v1:
# era uma 2ª chamada de LLM em quase toda resposta.
FEATURE_QUERY_TRANSFORM_LLM=false
# v1 — rotas ligadas (kill-switch por rota). Vazio = sem restrição.
# As demais (CALENDARIO, EDITAL, SIGAA, TICKET_ABERTURA, CRUD,
# MEDIA_DOWNLOAD, CHECK_STATUS) voltam quando tiverem integração real.
ROTAS_ATIVAS=WIKI,CONTATOS,GREETING,ESCALAR_HUMANO
# v1 — higiene de checkpoint (item B10). Horas de TTL aplicadas às chaves
# `checkpoint:*` que ainda não têm TTL. 0 = desligado. A task nunca apaga
# chave, só marca o TTL e deixa o Redis expirar.
CHECKPOINT_TTL_HORAS=0

# ── Telemetria de custo de LLM ──────────────────────────────────────────
# Catálogo público do OpenRouter: usado SÓ para consultar preço de modelo que
# não está cadastrado em /hub/llm-custo. Nunca para inferência, e nunca no
# caminho de uma resposta — a tarefa `atualizar_catalogo_precos` preenche um
# cache no Redis de 12 em 12 horas, e o resolvedor só lê esse cache.
# Não exige chave de API.
OPENROUTER_CATALOG_URL=https://openrouter.ai/api/v1/models
OPENROUTER_CATALOG_TTL_H=12

# Camadas de fallback de preço, desligadas por padrão.
# - LiteLLM exige `pip install litellm` (não está no requirements).
# - PricePerToken não tem fonte implementada: o adaptador existe com a
#   interface pronta, e ligar sem implementar só gera aviso no log.
FEATURE_PRICING_LITELLM=false
FEATURE_PRICING_PRICEPERTOKEN=false

# ── Wiki da CTIC (base de conhecimento do v1) ───────────────────────────
WIKI_CTIC_URL=https://ctic.uema.br/wiki/doku.php
WIKI_INGEST_CONCORRENCIA=4

# ── Limite de mensagens por pessoa ─────────────────────────────────────
# Vale só para mensagem que vira PERGUNTA: navegar o menu não conta, porque
# não gasta token. Ajustável em runtime por /hub/config.
RATE_LIMIT_MSGS=8
RATE_LIMIT_WINDOW_S=60

# ── Embeddings ─────────────────────────────────────────────────────────
# Trocar de modelo muda a dimensão do vetor e EXIGE recriar o índice e
# reingerir tudo — o boot avisa se o índice existente divergir.
# 0 = deriva do provedor (o normal).
EMBEDDING_DIM=0
