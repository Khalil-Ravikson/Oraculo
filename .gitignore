# Segurança (NUNCA REMOVA ISSO)
.env
.env.local
.env.*
# Ordem importa: a negação precisa vir DEPOIS de ".env.*" pra valer — regra
# anterior (!.env.example antes de .env.*) nunca funcionou de verdade,
# achado real ao tentar rastrear o .env.example criado nesta sessão.
!.env.example
.venv

# Sessões do WhatsApp e Dados do Banco
waha-data/
pgdata/
postgres_data/
pg-data/
pg-data-v2/
pg-data-v3/
pg-data*/


# Python e Ambiente Virtual
.venv/
venv/
__pycache__/
*.pyc

# Logs e Sistemas
*.log
.DS_Store
.vscode/



# Dados e Arquivos Temporários
dados/
tmp/
*.pdf
*.csv

# Clone local do fonte da Evolution API (repo próprio, com .git aninhado —
# usado só como referência local, não faz parte deste projeto)
evolution-api/

# Backups
.oraculo_backup_*

# Testes e Cache
.env.test
.pytest_cache/

# Config local do Claude Code (permissões de shell específicas da máquina/dev
# — por convenção .local.json não deveria ser versionado; estava sendo
# rastreado por engano, corrigido em 2026-08-25)
.claude/settings.local.json
